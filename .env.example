# Student Management API configuration
# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.

DATABASE_URL=postgresql://username:password@localhost:5432/student_management

# Use a long, random value (at least 32 characters). Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
